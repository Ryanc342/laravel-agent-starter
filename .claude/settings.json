{
    "enabledMcpjsonServers": [
        "laravel-boost",
        "playwright",
        "playwright-review"
    ],
    "env": {
        "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1"
    },
    "permissions": {
        "allow": [
            "Bash(scripts/screen-round)",
            "Bash(php scripts/screen-round)",
            "Bash(scripts/screen-round --reference)",
            "Bash(php scripts/screen-round --reference)"
        ],
        "deny": ["AskUserQuestion", "Workflow"]
    },
    "hooks": {
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "php -d display_errors=stderr -d display_startup_errors=0 \"$CLAUDE_PROJECT_DIR/scripts/hooks/finish-check.php\" stop || echo '{\"systemMessage\":\"The finish check could not run.\"}'",
                        "timeout": 60
                    }
                ]
            }
        ]
    }
}
