includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Rules locked by PHPStan (spaze/phpstan-disallowed-calls), from
    # docs/golden-principles.md. Each entry says what to do instead. Never widen
    # allowIn or narrow allowExceptIn to make code pass: move the code to where
    # it belongs.
    #
    # spaze matches the class that declares a method. Larastan reports static
    # model calls such as User::create() and User::find() as declared on the
    # Eloquent Builder (query() and destroy() on Model), so the entries name
    # those classes, never App\Models\*.
    filesRootDir: %rootDir%/../../..

    disallowedMethodCalls:
        -
            method:
                - 'Illuminate\Database\Eloquent\Model::save()'
                - 'Illuminate\Database\Eloquent\Model::update()'
                - 'Illuminate\Database\Eloquent\Model::delete()'
                - 'Illuminate\Database\Eloquent\Model::forceDelete()'
                - 'Illuminate\Database\Eloquent\Model::increment()'
                - 'Illuminate\Database\Eloquent\Model::decrement()'
                - 'Illuminate\Database\Eloquent\Model::push()'
                - 'Illuminate\Database\Eloquent\Builder::create()'
                - 'Illuminate\Database\Eloquent\Builder::forceCreate()'
                - 'Illuminate\Database\Eloquent\Builder::update()'
                - 'Illuminate\Database\Eloquent\Builder::delete()'
                - 'Illuminate\Database\Eloquent\Builder::updateOrCreate()'
                - 'Illuminate\Database\Eloquent\Builder::firstOrCreate()'
                - 'Illuminate\Database\Eloquent\Relations\HasOneOrMany::create()'
                - 'Illuminate\Database\Eloquent\Relations\HasOneOrMany::save()'
                - 'Illuminate\Database\Eloquent\Relations\BelongsToMany::attach()'
                - 'Illuminate\Database\Eloquent\Relations\BelongsToMany::detach()'
                - 'Illuminate\Database\Eloquent\Relations\BelongsToMany::sync()'
                - 'Illuminate\Notifications\DatabaseNotification::markAsRead()'
                - 'Illuminate\Notifications\DatabaseNotification::markAsUnread()'
                - 'Illuminate\Notifications\DatabaseNotificationCollection::markAsRead()'
                - 'Illuminate\Notifications\DatabaseNotificationCollection::markAsUnread()'
                - 'Illuminate\Notifications\Notifiable::notify()'
                - 'Illuminate\Notifications\Notifiable::notifyNow()'
            message: 'writes belong in an Action'
            errorTip: 'Move the write into app/Actions/{Domain}/{Verb}{Noun}.php and call the Action from here. See ARCHITECTURE.md.'
            allowIn:
                - app/Actions/*
                - database/*
        -
            method:
                - 'Illuminate\Http\Request::validate()'
                - 'Illuminate\Http\Request::validateWithBag()'
            message: 'validate input in a FormRequest'
            errorTip: 'Create app/Http/Requests/{Domain}/{Verb}{Model}Request.php with the rules and type-hint it in the controller method. See docs/rules/form-requests.md.'
        -
            method:
                - 'Illuminate\Database\Eloquent\Builder::*()'
                - 'Illuminate\Database\Query\Builder::*()'
                - 'Illuminate\Database\Eloquent\Relations\Relation::*()'
            message: 'a FormRequest checks the shape of the input only'
            errorTip: 'Business state (stock, status, ownership, limits) is checked in the Action, which throws ValidationException::withMessages(). For "this record exists" use the exists and unique rules. See docs/rules/form-requests.md.'
            allowExceptIn:
                - app/Http/Requests/*
                - app/Concerns/*
        -
            method:
                - 'Illuminate\Database\Eloquent\Model::toArray()'
                - 'Illuminate\Database\Eloquent\Model::attributesToArray()'
            message: 'list each field by name'
            errorTip: 'A Resource names every field it sends to React, so nothing private leaks and the TypeScript type can match it. See docs/rules/frontend.md.'
            allowExceptIn:
                - app/Http/Resources/*

    disallowedStaticCalls:
        -
            method:
                - 'Illuminate\Database\Eloquent\Builder::create()'
                - 'Illuminate\Database\Eloquent\Builder::forceCreate()'
                - 'Illuminate\Database\Eloquent\Builder::updateOrCreate()'
                - 'Illuminate\Database\Eloquent\Builder::firstOrCreate()'
                - 'Illuminate\Database\Eloquent\Model::destroy()'
                - 'Illuminate\Support\Facades\Notification::send()'
                - 'Illuminate\Support\Facades\Notification::sendNow()'
            message: 'writes belong in an Action'
            errorTip: 'Move the write into app/Actions/{Domain}/{Verb}{Noun}.php and call the Action from here. See ARCHITECTURE.md.'
            allowIn:
                - app/Actions/*
                - database/*
        -
            method:
                - 'App\Enums\*::from()'
                - 'App\Enums\*::tryFrom()'
            message: 'turn input into an enum only where input arrives'
            errorTip: 'FormRequests, Actions and console commands may call from() on input. In a controller use $request->enum(). To get one enum from another, call a method on the enum (for example $role->locationType()); never rely on two enums sharing the same values.'
            allowIn:
                - app/Enums/*
                - app/Http/Requests/*
                - app/Actions/*
                - app/Console/*
        -
            method:
                - 'Illuminate\Support\Facades\Validator::make()'
            message: 'validate input in a FormRequest'
            errorTip: 'Create app/Http/Requests/{Domain}/{Verb}{Model}Request.php with the rules and type-hint it in the controller method. See docs/rules/form-requests.md.'
            allowIn:
                - app/Http/Fortify/*
        -
            method:
                - 'Illuminate\Database\Eloquent\Model::*()'
                - 'Illuminate\Database\Eloquent\Builder::*()'
                - 'Illuminate\Database\Query\Builder::*()'
                - 'Illuminate\Support\Facades\DB::*()'
            message: 'a FormRequest checks the shape of the input only'
            errorTip: 'Business state (stock, status, ownership, limits) is checked in the Action, which throws ValidationException::withMessages(). For "this record exists" use the exists and unique rules. See docs/rules/form-requests.md.'
            allowExceptIn:
                - app/Http/Requests/*
                - app/Concerns/*
        -
            method:
                - 'Illuminate\Http\Resources\Json\JsonResource::toArray()'
            message: 'list each field by name'
            errorTip: 'A Resource names every field it sends to React, so nothing private leaks and the TypeScript type can match it. See docs/rules/frontend.md.'
            allowExceptIn:
                - app/Http/Resources/*

    disallowedFunctionCalls:
        -
            function: 'validator()'
            message: 'validate input in a FormRequest'
            errorTip: 'Create app/Http/Requests/{Domain}/{Verb}{Model}Request.php with the rules and type-hint it in the controller method. See docs/rules/form-requests.md.'
            allowIn:
                - app/Http/Fortify/*
