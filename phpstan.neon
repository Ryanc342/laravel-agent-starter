includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon

services:
    -
        class: Lint\PHPStan\DisallowedTypeResolver
        autowired: Spaze\PHPStan\Rules\Disallowed\Type\TypeResolver

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # PHPStan's cache lives in this project, so copies of the template that
    # run at the same time (worktrees, experiments) never share it.
    tmpDir: storage/framework/cache/phpstan

    # The skeleton's PHPStan rules (spaze/phpstan-disallowed-calls): each
    # `machine` rule of a card in .claude/rules/skeleton/ that names PHPStan.
    # Each entry says what to do instead and names its card. Never widen allowIn or
    # narrow allowExceptIn to make code pass: move the code to where it belongs.
    # tests/Structure/ConfigTest.php checks that every entry keeps its folders.
    filesRootDir: %rootDir%/../../..

    # Principle 2: layers only depend downwards. A class may not use (import,
    # type-hint, call or extend) anything from the namespaces listed. spaze keeps
    # one entry per namespace (a second entry for the same namespace replaces the
    # first), so each namespace is listed once, with every folder it is banned in.
    disallowedNamespaces:
        -
            namespace:
                - 'App\Models\*'
            message: 'enums are the bottom layer'
            errorTip: 'An enum only knows its own cases, labels and small decisions about itself. Move this logic into the model, Policy or Action that owns it. See .claude/rules/skeleton/enum.md.'
            allowExceptIn:
                - app/Enums/*
        -
            namespace:
                - 'App\Policies\*'
            message: 'enums and models use no policies'
            errorTip: 'A model holds fields, relations, scopes and is*/can* methods; the controller asks the Policy. See .claude/rules/skeleton/model.md.'
            allowExceptIn:
                - app/Enums/*
                - app/Models/*
        -
            namespace:
                - 'App\Actions\*'
            message: 'only controllers and Actions call Actions'
            errorTip: 'Enums, models, policies and notifications sit below the Actions; a FormRequest only checks the shape of the input. A Resource may name an operation only to ask App\Http\OperationGate whether it can run now. See .claude/rules/skeleton/act.md.'
            allowExceptIn:
                - app/Enums/*
                - app/Models/*
                - app/Policies/*
                - app/Notifications/*
                - app/Http/Requests/*
        -
            namespace:
                - 'App\Http\*'
            message: 'only the http layer uses app/Http'
            errorTip: 'An Action takes plain values (the validated array, models, enums); enums, models, policies and notifications know nothing about controllers, requests or Resources. See .claude/rules/skeleton/act.md.'
            allowExceptIn:
                - app/Enums/*
                - app/Models/*
                - app/Policies/*
                - app/Notifications/*
                - app/Actions/*
        -
            namespace:
                - 'Illuminate\Http\*'
                - 'Symfony\Component\HttpFoundation\*'
                - 'Symfony\Component\HttpKernel\*'
                - 'Illuminate\Support\Facades\Request'
                - 'Illuminate\Support\Facades\Response'
                - 'Illuminate\Support\Facades\Session'
                - 'Illuminate\Support\Facades\Auth'
                - 'Illuminate\Support\Facades\Redirect'
                - 'Illuminate\Support\Facades\URL'
                - 'Illuminate\Support\Facades\Cookie'
                - 'Illuminate\Contracts\Auth\Guard'
                - 'Illuminate\Contracts\Auth\StatefulGuard'
                - 'Illuminate\Contracts\Auth\Factory'
                - 'Illuminate\Auth\AuthManager'
                - 'Illuminate\Auth\SessionGuard'
                - 'Illuminate\Session\*'
                - 'Illuminate\Contracts\Session\*'
                - 'Inertia\*'
            exclude:
                - 'Illuminate\Http\Client\*'
            message: 'only controllers deal with the request'
            errorTip: 'Actions, enums, models, policies and notifications work with plain values: the controller reads the request and the signed-in user, passes them in and returns the response. A refusal in an Action is a ValidationException. See .claude/rules/skeleton/act.md.'
            allowExceptIn:
                - app/Enums/*
                - app/Models/*
                - app/Policies/*
                - app/Notifications/*
                - app/Actions/*
        -
            namespace:
                - 'Illuminate\Support\Facades\Gate'
                - 'Illuminate\Contracts\Auth\Access\Gate'
                - 'Illuminate\Auth\Access\AuthorizationException'
            message: 'models and enums do not check permissions'
            errorTip: 'A model holds fields, relations, scopes and is*/can* methods, an enum its cases; the operation part and the controller ask the Policy. See .claude/rules/skeleton/model.md.'
            allowExceptIn:
                - app/Enums/*
                - app/Models/*
        -
            namespace:
                - 'Illuminate\Support\Facades\DB'
                - 'Illuminate\Support\Facades\Schema'
                - 'Illuminate\Database\ConnectionInterface'
                - 'Illuminate\Database\Connection'
                - 'Illuminate\Database\DatabaseManager'
            message: 'controllers do not use the database directly'
            errorTip: 'Put the work, and any transaction, in an Action. See .claude/rules/skeleton/ctrl.md.'
            allowExceptIn:
                - app/Http/Controllers/*
        -
            namespace:
                - 'App\Actions\OutsideCall'
            message: 'the outside-service part is called only from actions'
            errorTip: 'Call App\Actions\OutsideCall from an Action: read() in its prepare(), change() in its afterCommit(). See .claude/rules/skeleton/ext.md.'
            allowIn:
                - app/Actions/*
                - app/Jobs/OperationJob.php
        -
            namespace:
                - 'Illuminate\Support\Facades\Http'
                - 'Illuminate\Http\Client\*'
            message: 'the http client is used only in the outside-service part'
            errorTip: 'Call App\Actions\OutsideCall::read() or ::change() from an Action; the service settings go in config/services.php. See .claude/rules/skeleton/ext.md.'
            allowIn:
                - app/Actions/OutsideCall.php
        -
            namespace:
                - 'Illuminate\Support\Facades\Storage'
                - 'Illuminate\Contracts\Filesystem\*'
            message: 'only the file part touches file storage'
            errorTip: 'Name the field in files() of the operation; delete with StoredFile::deleteAfterCommit(); send it with Route::download(). See .claude/rules/skeleton/files.md.'
            allowIn:
                - app/Support/StoredFile.php
        -
            namespace:
                - 'Illuminate\Support\Facades\Mail'
                - 'Illuminate\Support\Facades\Notification'
                - 'Illuminate\Contracts\Mail\Factory'
                - 'Illuminate\Contracts\Mail\Mailer'
                - 'Illuminate\Mail\MailManager'
                - 'Illuminate\Mail\Mailer'
                - 'Illuminate\Contracts\Notifications\Dispatcher'
                - 'Illuminate\Notifications\ChannelManager'
            message: 'only Actions send mail and notifications'
            errorTip: 'Send it in the perform() of the operation that causes it. See .claude/rules/skeleton/act-to-note.md.'
            allowIn:
                - app/Actions/*
        -
            namespace:
                - 'Database\Seeders\*'
            message: 'seeders only fill the database'
            errorTip: 'Code the app runs goes in app/: a write in an Action, a query in a model scope. See .claude/rules/skeleton/test.md.'
            allowIn:
                - database/*
        -
            namespace:
                - 'Database\Factories\*'
            message: 'factories are for tests and seeders'
            errorTip: 'Code the app runs goes in app/: a write in an Action, a query in a model scope. A model names its factory in its HasFactory annotation only. See .claude/rules/skeleton/fact.md.'
            allowIn:
                - database/*
                - app/Models/*
        -
            namespace:
                - 'Tests\*'
            message: 'the app never uses test code'
            errorTip: 'Code the app runs goes in app/. See .claude/rules/skeleton/test.md.'

    disallowedStaticCalls:
        -
            method: 'Illuminate\Database\Eloquent\Factories\HasFactory::factory()'
            message: 'factories are for tests and seeders'
            errorTip: 'Code the app runs creates records in an Action. See .claude/rules/skeleton/fact.md.'
            allowIn:
                - database/*

    disallowedMethodCalls:
        -
            method:
                - 'Illuminate\Database\Eloquent\Model::getConnection()'
                - 'Illuminate\Database\Eloquent\Builder::getConnection()'
                - 'Illuminate\Database\Query\Builder::getConnection()'
            message: 'controllers do not use the database directly'
            errorTip: 'Put the work, and any transaction, in an Action. See .claude/rules/skeleton/ctrl.md.'
            allowExceptIn:
                - app/Http/Controllers/*
        -
            method:
                - 'Illuminate\Foundation\Auth\Access\Authorizable::can()'
                - 'Illuminate\Foundation\Auth\Access\Authorizable::cannot()'
                - 'Illuminate\Foundation\Auth\Access\Authorizable::cant()'
            message: 'models and enums do not check permissions'
            errorTip: 'A model holds fields, relations, scopes and is*/can* methods, an enum its cases; the operation part and the controller ask the Policy. See .claude/rules/skeleton/model.md.'
            allowExceptIn:
                - app/Enums/*
                - app/Models/*
        -
            method:
                - 'Illuminate\Notifications\Notifiable::notify()'
                - 'Illuminate\Notifications\Notifiable::notifyNow()'
                - 'Illuminate\Notifications\RoutesNotifications::notify()'
                - 'Illuminate\Notifications\RoutesNotifications::notifyNow()'
            message: 'only Actions send mail and notifications'
            errorTip: 'Send it in the perform() of the operation that causes it. See .claude/rules/skeleton/act-to-note.md.'
            allowIn:
                - app/Actions/*
        -
            method:
                - 'App\Actions\Operation::run()'
                - 'App\Actions\UserlessOperation::run()'
            message: 'only the operation part, Actions, Fortify adapters, commands and jobs run an operation'
            errorTip: 'Expose the operation with Route::operation(); a Resource or a page flag asks App\Http\OperationGate::allows() whether it can run. See .claude/rules/skeleton/res.md.'
            allowIn:
                - app/Http/Controllers/OperationController.php
                - app/Actions/*
                - app/Http/Fortify/*
                - app/Console/*
                - app/Jobs/*
        -
            method: 'App\Actions\UserlessOperation::runBySystem()'
            message: 'only schedules, commands and signed calls from other systems run an operation as the system'
            errorTip: 'A user or a guest runs it with run(), which checks the permission. See .claude/rules/skeleton/cmd.md.'
            allowIn:
                - app/Console/*
                - app/Jobs/*
                - app/Http/Controllers/WebhookController.php

    disallowedFunctionCalls:
        -
            function:
                - 'request()'
                - 'response()'
                - 'redirect()'
                - 'back()'
                - 'to_route()'
                - 'inertia()'
                - 'session()'
                - 'auth()'
                - 'abort()'
                - 'abort_if()'
                - 'abort_unless()'
                - 'url()'
                - 'cookie()'
            message: 'only controllers deal with the request'
            errorTip: 'Actions, enums, models, policies and notifications work with plain values (the validated array, models, enums): the controller reads the request and the signed-in user, passes them in and returns the response. A refusal in an Action is a ValidationException. See .claude/rules/skeleton/act.md.'
            allowExceptIn:
                - app/Actions/*
                - app/Enums/*
                - app/Models/*
                - app/Policies/*
                - app/Notifications/*
