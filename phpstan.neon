includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon

# Ezdev's own rules for docs/golden-principles.md, in lint/phpstan/.
rules:
    - Lint\PHPStan\ClassShapeRule
    - Lint\PHPStan\CompanionFilesRule
    - Lint\PHPStan\ConditionsLiveInModelsRule
    - Lint\PHPStan\ModelScopesRule
    - Lint\PHPStan\PagePropsUseResourcesRule
    - Lint\PHPStan\TraitPlacementRule

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Rules locked by PHPStan (spaze/phpstan-disallowed-calls), from
    # docs/golden-principles.md. Each entry says what to do instead. Never widen
    # allowIn or narrow allowExceptIn to make code pass: move the code to where
    # it belongs.
    #
    # spaze matches the class that declares a method. Larastan reports static
    # model calls such as User::create() and User::find() as declared on the
    # Eloquent Builder (query() and destroy() on Model), so the entries name
    # those classes, never App\Models\*.
    filesRootDir: %rootDir%/../../..

    # Principle 2: layers only depend downwards. A class may not use (import,
    # type-hint, call or extend) anything from the namespaces listed.
    disallowedNamespaces:
        -
            namespace:
                - 'App\Models\*'
                - 'App\Policies\*'
                - 'App\Actions\*'
                - 'App\Http\*'
            message: 'enums are the bottom layer'
            errorTip: 'An enum only knows its own cases, labels and small decisions about itself. Move this logic into the model, Policy or Action that owns it. See ARCHITECTURE.md.'
            allowExceptIn:
                - app/Enums/*
        -
            namespace:
                - 'App\Policies\*'
                - 'App\Actions\*'
                - 'App\Http\*'
            message: 'models use no policies, actions or http'
            errorTip: 'A model holds fields, relations, scopes and is*/can* methods. Move the work into an Action. See ARCHITECTURE.md.'
            allowExceptIn:
                - app/Models/*
        -
            namespace:
                - 'App\Actions\*'
                - 'App\Http\*'
            message: 'policies only ask models and enums'
            errorTip: 'A Policy answers yes or no from the model (isOwnedBy(), canBeCompleted()). See docs/rules/models.md.'
            allowExceptIn:
                - app/Policies/*
        -
            namespace:
                - 'App\Actions\*'
                - 'App\Http\*'
            message: 'notifications only describe a message'
            errorTip: 'An Action decides when to send a notification; the notification only builds its text. See ARCHITECTURE.md.'
            allowExceptIn:
                - app/Notifications/*
        -
            namespace: 'App\Actions\*'
            message: 'resources and form requests only read'
            errorTip: 'A Resource asks the Policy for can.*; a FormRequest checks the shape of the input. The controller calls the Action. See ARCHITECTURE.md.'
            allowExceptIn:
                - app/Http/Resources/*
                - app/Http/Requests/*
        -
            namespace: 'Illuminate\Support\Facades\DB'
            message: 'controllers do not use the database directly'
            errorTip: 'Put the work, and any transaction, in an Action. See docs/rules/actions.md.'
            allowExceptIn:
                - app/Http/Controllers/*
        -
            namespace:
                - 'App\Http\*'
                - 'Inertia\*'
                - 'Illuminate\Http\*'
                - 'Symfony\Component\HttpFoundation\*'
                - 'Illuminate\Support\Facades\Request'
                - 'Illuminate\Support\Facades\Response'
            message: 'actions do not depend on http'
            errorTip: 'An Action takes plain values (the validated array, models, enums). The controller reads the request and returns the response. See docs/rules/actions.md.'
            allowExceptIn:
                - app/Actions/*
        -
            namespace:
                - 'Illuminate\Support\Facades\Gate'
                - 'Illuminate\Contracts\Auth\Access\Gate'
                - 'Illuminate\Auth\Access\AuthorizationException'
            message: 'actions do not ask for permission again'
            errorTip: 'The controller authorizes once with Gate::authorize(). A business state the Action needs is checked with a model method and ValidationException. See docs/rules/actions.md.'
            allowExceptIn:
                - app/Actions/*
        -
            namespace: 'App\Integrations\*'
            message: 'integrations are called only from actions'
            errorTip: 'Call the integration from an Action, and call that Action from here. See ARCHITECTURE.md.'
            allowIn:
                - app/Actions/*
                - app/Integrations/*
        -
            namespace:
                - 'Illuminate\Support\Facades\Http'
                - 'Illuminate\Http\Client\*'
            message: 'the http client is used only in app/Integrations'
            errorTip: 'Wrap the external service in app/Integrations/{Service}.php and call it from an Action. See ARCHITECTURE.md.'
            allowIn:
                - app/Integrations/*

    disallowedMethodCalls:
        -
            method:
                - 'Illuminate\Database\Eloquent\Model::save()'
                - 'Illuminate\Database\Eloquent\Model::update()'
                - 'Illuminate\Database\Eloquent\Model::delete()'
                - 'Illuminate\Database\Eloquent\Model::forceDelete()'
                - 'Illuminate\Database\Eloquent\Model::increment()'
                - 'Illuminate\Database\Eloquent\Model::decrement()'
                - 'Illuminate\Database\Eloquent\Model::push()'
                - 'Illuminate\Database\Eloquent\Builder::create()'
                - 'Illuminate\Database\Eloquent\Builder::forceCreate()'
                - 'Illuminate\Database\Eloquent\Builder::update()'
                - 'Illuminate\Database\Eloquent\Builder::delete()'
                - 'Illuminate\Database\Eloquent\Builder::updateOrCreate()'
                - 'Illuminate\Database\Eloquent\Builder::firstOrCreate()'
                - 'Illuminate\Database\Eloquent\Relations\HasOneOrMany::create()'
                - 'Illuminate\Database\Eloquent\Relations\HasOneOrMany::save()'
                - 'Illuminate\Database\Eloquent\Relations\BelongsToMany::attach()'
                - 'Illuminate\Database\Eloquent\Relations\BelongsToMany::detach()'
                - 'Illuminate\Database\Eloquent\Relations\BelongsToMany::sync()'
                - 'Illuminate\Notifications\DatabaseNotification::markAsRead()'
                - 'Illuminate\Notifications\DatabaseNotification::markAsUnread()'
                - 'Illuminate\Notifications\DatabaseNotificationCollection::markAsRead()'
                - 'Illuminate\Notifications\DatabaseNotificationCollection::markAsUnread()'
                - 'Illuminate\Notifications\Notifiable::notify()'
                - 'Illuminate\Notifications\Notifiable::notifyNow()'
            message: 'writes belong in an Action'
            errorTip: 'Move the write into app/Actions/{Domain}/{Verb}{Noun}.php and call the Action from here. See ARCHITECTURE.md.'
            allowIn:
                - app/Actions/*
                - database/*
        -
            method:
                - 'Illuminate\Http\Request::validate()'
                - 'Illuminate\Http\Request::validateWithBag()'
            message: 'validate input in a FormRequest'
            errorTip: 'Create app/Http/Requests/{Domain}/{Verb}{Model}Request.php with the rules and type-hint it in the controller method. See docs/rules/form-requests.md.'
        -
            method:
                - 'Illuminate\Database\Eloquent\Builder::*()'
                - 'Illuminate\Database\Query\Builder::*()'
                - 'Illuminate\Database\Eloquent\Relations\Relation::*()'
            message: 'a FormRequest checks the shape of the input only'
            errorTip: 'Business state (stock, status, ownership, limits) is checked in the Action, which throws ValidationException::withMessages(). For "this record exists" use the exists and unique rules. See docs/rules/form-requests.md.'
            allowExceptIn:
                - app/Http/Requests/*
                - app/Concerns/*
        -
            method:
                - 'Illuminate\Database\Eloquent\Model::toArray()'
                - 'Illuminate\Database\Eloquent\Model::attributesToArray()'
            message: 'list each field by name'
            errorTip: 'A Resource names every field it sends to React, so nothing private leaks and the TypeScript type can match it. See docs/rules/frontend.md.'
            allowExceptIn:
                - app/Http/Resources/*
        -
            method:
                - 'Illuminate\Foundation\Auth\Access\Authorizable::can()'
                - 'Illuminate\Foundation\Auth\Access\Authorizable::canAny()'
                - 'Illuminate\Foundation\Auth\Access\Authorizable::cannot()'
                - 'Illuminate\Foundation\Auth\Access\Authorizable::cant()'
            message: 'actions do not ask for permission again'
            errorTip: 'The controller authorizes once with Gate::authorize(). A business state the Action needs is checked with a model method and ValidationException. See docs/rules/actions.md.'
            allowExceptIn:
                - app/Actions/*
        -
            method:
                - 'Illuminate\Database\Eloquent\Builder::where*()'
                - 'Illuminate\Database\Eloquent\Builder::orWhere*()'
                - 'Illuminate\Database\Query\Builder::where*()'
                - 'Illuminate\Database\Query\Builder::orWhere*()'
            exclude:
                - 'Illuminate\Database\Eloquent\Builder::whereKey()'
                - 'Illuminate\Database\Eloquent\Builder::whereKeyNot()'
            message: 'query conditions live in a model scope'
            errorTip: 'Add a #[Scope] method to the model (ownedBy(), open()) and call it by name. One record asks the same scope with whereKey($id)->exists(). See docs/rules/models.md.'
            allowIn:
                - app/Models/*
                - database/*

    disallowedStaticCalls:
        -
            method:
                - 'Illuminate\Database\Eloquent\Builder::create()'
                - 'Illuminate\Database\Eloquent\Builder::forceCreate()'
                - 'Illuminate\Database\Eloquent\Builder::updateOrCreate()'
                - 'Illuminate\Database\Eloquent\Builder::firstOrCreate()'
                - 'Illuminate\Database\Eloquent\Model::destroy()'
                - 'Illuminate\Support\Facades\Notification::send()'
                - 'Illuminate\Support\Facades\Notification::sendNow()'
            message: 'writes belong in an Action'
            errorTip: 'Move the write into app/Actions/{Domain}/{Verb}{Noun}.php and call the Action from here. See ARCHITECTURE.md.'
            allowIn:
                - app/Actions/*
                - database/*
        -
            method:
                - 'App\Enums\*::from()'
                - 'App\Enums\*::tryFrom()'
            message: 'turn input into an enum only where input arrives'
            errorTip: 'FormRequests, Actions and console commands may call from() on input. In a controller use $request->enum(). To get one enum from another, call a method on the enum (for example $role->locationType()); never rely on two enums sharing the same values.'
            allowIn:
                - app/Enums/*
                - app/Http/Requests/*
                - app/Actions/*
                - app/Console/*
        -
            method:
                - 'Illuminate\Support\Facades\Validator::make()'
            message: 'validate input in a FormRequest'
            errorTip: 'Create app/Http/Requests/{Domain}/{Verb}{Model}Request.php with the rules and type-hint it in the controller method. See docs/rules/form-requests.md.'
            allowIn:
                - app/Http/Fortify/*
        -
            method:
                - 'Illuminate\Database\Eloquent\Model::*()'
                - 'Illuminate\Database\Eloquent\Builder::*()'
                - 'Illuminate\Database\Query\Builder::*()'
                - 'Illuminate\Support\Facades\DB::*()'
            message: 'a FormRequest checks the shape of the input only'
            errorTip: 'Business state (stock, status, ownership, limits) is checked in the Action, which throws ValidationException::withMessages(). For "this record exists" use the exists and unique rules. See docs/rules/form-requests.md.'
            allowExceptIn:
                - app/Http/Requests/*
                - app/Concerns/*
        -
            method:
                - 'Illuminate\Http\Resources\Json\JsonResource::toArray()'
            message: 'list each field by name'
            errorTip: 'A Resource names every field it sends to React, so nothing private leaks and the TypeScript type can match it. See docs/rules/frontend.md.'
            allowExceptIn:
                - app/Http/Resources/*

        -
            method:
                - 'Illuminate\Database\Eloquent\Builder::where*()'
                - 'Illuminate\Database\Eloquent\Builder::orWhere*()'
                - 'Illuminate\Database\Query\Builder::where*()'
                - 'Illuminate\Database\Query\Builder::orWhere*()'
            exclude:
                - 'Illuminate\Database\Eloquent\Builder::whereKey()'
                - 'Illuminate\Database\Eloquent\Builder::whereKeyNot()'
            message: 'query conditions live in a model scope'
            errorTip: 'Add a #[Scope] method to the model (ownedBy(), open()) and call it by name. One record asks the same scope with whereKey($id)->exists(). See docs/rules/models.md.'
            allowIn:
                - app/Models/*
                - database/*

    disallowedFunctionCalls:
        -
            function:
                - 'request()'
                - 'response()'
                - 'redirect()'
                - 'back()'
                - 'to_route()'
                - 'inertia()'
            message: 'actions do not depend on http'
            errorTip: 'An Action takes plain values (the validated array, models, enums). The controller reads the request and returns the response. See docs/rules/actions.md.'
            allowExceptIn:
                - app/Actions/*
        -
            function: 'validator()'
            message: 'validate input in a FormRequest'
            errorTip: 'Create app/Http/Requests/{Domain}/{Verb}{Model}Request.php with the rules and type-hint it in the controller method. See docs/rules/form-requests.md.'
            allowIn:
                - app/Http/Fortify/*
