includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon

services:
    -
        class: Lint\PHPStan\DisallowedTypeResolver
        autowired: Spaze\PHPStan\Rules\Disallowed\Type\TypeResolver

# Ezdev's own rules for docs/golden-principles.md, in lint/phpstan/.
rules:
    - Lint\PHPStan\ClassShapeRule
    - Lint\PHPStan\CompanionFilesRule
    - Lint\PHPStan\ControllerInputRule
    - Lint\PHPStan\ModelScopesRule
    - Lint\PHPStan\PagePropsUseResourcesRule
    - Lint\PHPStan\TraitPlacementRule

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # PHPStan's cache lives in this project, so copies of the template that
    # run at the same time (worktrees, experiments) never share it.
    tmpDir: storage/framework/cache/phpstan

    # Rules locked by PHPStan (spaze/phpstan-disallowed-calls), from
    # docs/golden-principles.md. Each entry says what to do instead. Never widen
    # allowIn or narrow allowExceptIn to make code pass: move the code to where
    # it belongs.
    #
    # spaze matches the class that declares a method. Larastan reports static
    # model calls such as User::create() and User::find() as declared on the
    # Eloquent Builder (query() and destroy() on Model), so the entries name
    # those classes, never App\Models\*.
    filesRootDir: %rootDir%/../../..

    # Principle 2: layers only depend downwards. A class may not use (import,
    # type-hint, call or extend) anything from the namespaces listed. spaze keeps
    # one entry per namespace (a second entry for the same namespace replaces the
    # first), so each namespace is listed once, with every folder it is banned in.
    disallowedNamespaces:
        -
            namespace:
                - 'App\Models\*'
            message: 'enums are the bottom layer'
            errorTip: 'An enum only knows its own cases, labels and small decisions about itself. Move this logic into the model, Policy or Action that owns it. See ARCHITECTURE.md.'
            allowExceptIn:
                - app/Enums/*
        -
            namespace:
                - 'App\Policies\*'
            message: 'enums and models use no policies'
            errorTip: 'A model holds fields, relations, scopes and is*/can* methods; the controller asks the Policy. See ARCHITECTURE.md.'
            allowExceptIn:
                - app/Enums/*
                - app/Models/*
        -
            namespace:
                - 'App\Actions\*'
            message: 'only controllers and Actions call Actions'
            errorTip: 'Enums, models, policies and notifications sit below the Actions; a Resource only reads and a FormRequest only checks the shape of the input. The controller calls the Action. See ARCHITECTURE.md.'
            allowExceptIn:
                - app/Enums/*
                - app/Models/*
                - app/Policies/*
                - app/Notifications/*
                - app/Http/Resources/*
                - app/Http/Requests/*
        -
            namespace:
                - 'App\Http\*'
            message: 'only the http layer uses app/Http'
            errorTip: 'An Action takes plain values (the validated array, models, enums); enums, models, policies and notifications know nothing about controllers, requests or Resources. See ARCHITECTURE.md.'
            allowExceptIn:
                - app/Enums/*
                - app/Models/*
                - app/Policies/*
                - app/Notifications/*
                - app/Actions/*
        -
            namespace:
                - 'Illuminate\Http\*'
                - 'Symfony\Component\HttpFoundation\*'
                - 'Symfony\Component\HttpKernel\*'
                - 'Illuminate\Support\Facades\Request'
                - 'Illuminate\Support\Facades\Response'
                - 'Illuminate\Support\Facades\Session'
                - 'Illuminate\Support\Facades\Auth'
                - 'Illuminate\Support\Facades\Redirect'
                - 'Illuminate\Support\Facades\URL'
                - 'Illuminate\Support\Facades\Cookie'
                - 'Inertia\*'
            message: 'only controllers deal with the request'
            errorTip: 'Actions, enums, models, policies and notifications work with plain values: the controller reads the request and the signed-in user, passes them in and returns the response. A refusal in an Action is a ValidationException. See docs/rules/actions.md.'
            allowExceptIn:
                - app/Enums/*
                - app/Models/*
                - app/Policies/*
                - app/Notifications/*
                - app/Actions/*
        -
            namespace:
                - 'Illuminate\Support\Facades\Gate'
                - 'Illuminate\Contracts\Auth\Access\Gate'
                - 'Illuminate\Auth\Access\AuthorizationException'
            message: 'permission is checked once, in the controller'
            errorTip: 'The controller authorizes once with Gate::authorize() and the Policy. A business state the Action needs is checked with a model method and ValidationException. See docs/rules/actions.md.'
            allowExceptIn:
                - app/Enums/*
                - app/Models/*
                - app/Policies/*
                - app/Notifications/*
                - app/Actions/*
        -
            namespace:
                - 'Illuminate\Support\Facades\DB'
            message: 'controllers do not use the database directly'
            errorTip: 'Put the work, and any transaction, in an Action. See docs/rules/actions.md.'
            allowExceptIn:
                - app/Http/Controllers/*
        -
            namespace:
                - 'App\Integrations\*'
            message: 'integrations are called only from actions'
            errorTip: 'Call the integration from an Action, and call that Action from here. See ARCHITECTURE.md.'
            allowIn:
                - app/Actions/*
                - app/Integrations/*
        -
            namespace:
                - 'Illuminate\Support\Facades\Http'
                - 'Illuminate\Http\Client\*'
            message: 'the http client is used only in app/Integrations'
            errorTip: 'Wrap the external service in app/Integrations/{Service}.php and call it from an Action. See ARCHITECTURE.md.'
            allowIn:
                - app/Integrations/*
        -
            namespace:
                - 'Illuminate\Contracts\Events\Dispatcher'
                - 'Illuminate\Events\Dispatcher'
            message: 'no events or listeners'
            errorTip: 'Do the work in the Action, and call another Action from it when a second step is needed. Events and listeners hide who does what. See docs/rules/actions.md.'
        -
            namespace:
                - 'Database\Seeders\*'
            message: 'seeders only fill the database'
            errorTip: 'Code the app runs goes in app/: a write in an Action, a query in a model scope. See ARCHITECTURE.md.'
            allowIn:
                - database/*
        -
            namespace:
                - 'Database\Factories\*'
            message: 'factories are for tests and seeders'
            errorTip: 'Code the app runs goes in app/: a write in an Action, a query in a model scope. A model names its factory in its HasFactory annotation only. See ARCHITECTURE.md.'
            allowIn:
                - database/*
                - app/Models/*
        -
            namespace:
                - 'Tests\*'
            message: 'the app never uses test code'
            errorTip: 'Code the app runs goes in app/. See ARCHITECTURE.md.'

    disallowedMethodCalls:
        -
            method:
                - 'Illuminate\Database\Eloquent\Model::save*()'
                - 'Illuminate\Database\Eloquent\Model::update*()'
                - 'Illuminate\Database\Eloquent\Model::delete*()'
                - 'Illuminate\Database\Eloquent\Model::forceDelete*()'
                - 'Illuminate\Database\Eloquent\Model::increment*()'
                - 'Illuminate\Database\Eloquent\Model::decrement*()'
                - 'Illuminate\Database\Eloquent\Model::push*()'
                - 'Illuminate\Database\Eloquent\Model::touch*()'
                - 'Illuminate\Database\Eloquent\Model::restore*()'
                - 'Illuminate\Database\Eloquent\Builder::create*()'
                - 'Illuminate\Database\Eloquent\Builder::forceCreate*()'
                - 'Illuminate\Database\Eloquent\Builder::insert*()'
                - 'Illuminate\Database\Eloquent\Builder::upsert()'
                - 'Illuminate\Database\Eloquent\Builder::update*()'
                - 'Illuminate\Database\Eloquent\Builder::delete()'
                - 'Illuminate\Database\Eloquent\Builder::forceDelete()'
                - 'Illuminate\Database\Eloquent\Builder::restore()'
                - 'Illuminate\Database\Eloquent\Builder::increment*()'
                - 'Illuminate\Database\Eloquent\Builder::decrement*()'
                - 'Illuminate\Database\Eloquent\Builder::touch()'
                - 'Illuminate\Database\Eloquent\Builder::firstOrCreate()'
                - 'Illuminate\Database\Eloquent\Builder::truncate()'
                - 'Illuminate\Database\Query\Builder::insert*()'
                - 'Illuminate\Database\Query\Builder::upsert()'
                - 'Illuminate\Database\Query\Builder::update*()'
                - 'Illuminate\Database\Query\Builder::delete()'
                - 'Illuminate\Database\Query\Builder::increment*()'
                - 'Illuminate\Database\Query\Builder::decrement*()'
                - 'Illuminate\Database\Query\Builder::truncate()'
                - 'Illuminate\Database\Connection::insert()'
                - 'Illuminate\Database\Connection::update()'
                - 'Illuminate\Database\Connection::delete()'
                - 'Illuminate\Database\Connection::statement()'
                - 'Illuminate\Database\Connection::affectingStatement()'
                - 'Illuminate\Database\Connection::unprepared()'
                - 'Illuminate\Database\Eloquent\Relations\HasOneOrMany::create*()'
                - 'Illuminate\Database\Eloquent\Relations\HasOneOrMany::forceCreate*()'
                - 'Illuminate\Database\Eloquent\Relations\HasOneOrMany::save*()'
                - 'Illuminate\Database\Eloquent\Relations\HasOneOrMany::updateOrCreate()'
                - 'Illuminate\Database\Eloquent\Relations\HasOneOrMany::firstOrCreate()'
                - 'Illuminate\Database\Eloquent\Relations\HasOneOrMany::upsert()'
                - 'Illuminate\Database\Eloquent\Relations\BelongsToMany::attach()'
                - 'Illuminate\Database\Eloquent\Relations\BelongsToMany::detach()'
                - 'Illuminate\Database\Eloquent\Relations\BelongsToMany::sync*()'
                - 'Illuminate\Database\Eloquent\Relations\BelongsToMany::toggle()'
                - 'Illuminate\Database\Eloquent\Relations\BelongsToMany::updateExistingPivot()'
                - 'Illuminate\Database\Eloquent\Relations\BelongsToMany::create*()'
                - 'Illuminate\Database\Eloquent\Relations\BelongsToMany::save*()'
                - 'Illuminate\Database\Eloquent\Relations\BelongsToMany::updateOrCreate()'
                - 'Illuminate\Database\Eloquent\Relations\BelongsToMany::firstOrCreate()'
                - 'Illuminate\Database\Eloquent\Relations\BelongsTo::associate()'
                - 'Illuminate\Database\Eloquent\Relations\BelongsTo::dissociate()'
                - 'Illuminate\Mail\PendingMail::send()'
                - 'Illuminate\Mail\PendingMail::queue()'
                - 'Illuminate\Notifications\AnonymousNotifiable::notify*()'
                - 'Illuminate\Notifications\DatabaseNotification::markAsRead()'
                - 'Illuminate\Notifications\DatabaseNotification::markAsUnread()'
                - 'Illuminate\Notifications\DatabaseNotificationCollection::markAsRead()'
                - 'Illuminate\Notifications\DatabaseNotificationCollection::markAsUnread()'
                - 'Illuminate\Notifications\Notifiable::notify()'
                - 'Illuminate\Notifications\Notifiable::notifyNow()'
            message: 'writes belong in an Action'
            errorTip: 'Move the write into app/Actions/{Domain}/{Verb}{Noun}.php and call the Action from here. See ARCHITECTURE.md.'
            allowIn:
                - app/Actions/*
                - database/*
        -
            method:
                - 'Illuminate\Http\Request::validate()'
                - 'Illuminate\Http\Request::validateWithBag()'
            message: 'validate input in a FormRequest'
            errorTip: 'Create app/Http/Requests/{Domain}/{Verb}{Model}Request.php with the rules and type-hint it in the controller method. See docs/rules/form-requests.md.'
        -
            method:
                - 'Illuminate\Database\Eloquent\Builder::*()'
                - 'Illuminate\Database\Query\Builder::*()'
                - 'Illuminate\Database\Eloquent\Relations\Relation::*()'
            message: 'a FormRequest checks the shape of the input only'
            errorTip: 'Business state (stock, status, ownership, limits) is checked in the Action, which throws ValidationException::withMessages(). For "this record exists" use the exists and unique rules. See docs/rules/form-requests.md.'
            allowExceptIn:
                - app/Http/Requests/*
                - app/Concerns/*
        -
            method:
                - 'Illuminate\Database\Eloquent\Model::toArray()'
                - 'Illuminate\Database\Eloquent\Model::attributesToArray()'
                - 'Illuminate\Database\Eloquent\Model::relationsToArray()'
                - 'Illuminate\Database\Eloquent\Model::getAttributes()'
                - 'Illuminate\Database\Eloquent\Model::getOriginal()'
                - 'Illuminate\Database\Eloquent\Model::getRawOriginal()'
                - 'Illuminate\Database\Eloquent\Model::toJson()'
                - 'Illuminate\Database\Eloquent\Model::jsonSerialize()'
            message: 'list each field by name'
            errorTip: 'A Resource names every field it sends to React, so nothing private leaks and the TypeScript type can match it. See docs/rules/frontend.md.'
        -
            method:
                - 'Illuminate\Foundation\Auth\Access\Authorizable::can()'
                - 'Illuminate\Foundation\Auth\Access\Authorizable::canAny()'
                - 'Illuminate\Foundation\Auth\Access\Authorizable::cannot()'
                - 'Illuminate\Foundation\Auth\Access\Authorizable::cant()'
            message: 'actions do not ask for permission again'
            errorTip: 'The controller authorizes once with Gate::authorize(). A business state the Action needs is checked with a model method and ValidationException. See docs/rules/actions.md.'
            allowExceptIn:
                - app/Actions/*
        -
            method:
                - 'Illuminate\Database\Eloquent\Builder::lockForUpdate()'
                - 'Illuminate\Database\Eloquent\Builder::sharedLock()'
                - 'Illuminate\Database\Eloquent\Builder::lock()'
                - 'Illuminate\Database\Query\Builder::lockForUpdate()'
                - 'Illuminate\Database\Query\Builder::sharedLock()'
                - 'Illuminate\Database\Query\Builder::lock()'
            message: 'rows are locked only in an Action'
            errorTip: 'Lock inside the Action that writes, in its DB::transaction(), and test the lock in tests/Feature/{Domain}/{Action}LockTest.php. Pages and Actions that only read never lock. See docs/rules/tests.md, Row locks.'
            allowIn:
                - app/Actions/*
        -
            method:
                - 'Illuminate\Database\Eloquent\Builder::where*()'
                - 'Illuminate\Database\Eloquent\Builder::orWhere*()'
                - 'Illuminate\Database\Query\Builder::where*()'
                - 'Illuminate\Database\Query\Builder::orWhere*()'
            exclude:
                - 'Illuminate\Database\Eloquent\Builder::whereKey()'
                - 'Illuminate\Database\Eloquent\Builder::whereKeyNot()'
            message: 'query conditions live in a model scope'
            errorTip: 'Add a #[Scope] method to the model (ownedBy(), open()) and call it by name. One record asks the same scope with whereKey($id)->exists(). See docs/rules/models.md.'
            allowIn:
                - app/Models/*
                - database/*

    disallowedStaticCalls:
        -
            method:
                - 'Illuminate\Database\Eloquent\Builder::create*()'
                - 'Illuminate\Database\Eloquent\Builder::forceCreate*()'
                - 'Illuminate\Database\Eloquent\Builder::insert*()'
                - 'Illuminate\Database\Eloquent\Builder::upsert()'
                - 'Illuminate\Database\Eloquent\Builder::updateOrCreate()'
                - 'Illuminate\Database\Eloquent\Builder::firstOrCreate()'
                - 'Illuminate\Database\Eloquent\Builder::truncate()'
                - 'Illuminate\Database\Eloquent\Model::destroy()'
                - 'Illuminate\Support\Facades\DB::insert()'
                - 'Illuminate\Support\Facades\DB::update()'
                - 'Illuminate\Support\Facades\DB::delete()'
                - 'Illuminate\Support\Facades\DB::statement()'
                - 'Illuminate\Support\Facades\DB::affectingStatement()'
                - 'Illuminate\Support\Facades\DB::unprepared()'
                - 'Illuminate\Support\Facades\Mail::send()'
                - 'Illuminate\Support\Facades\Mail::queue()'
                - 'Illuminate\Support\Facades\Notification::send()'
                - 'Illuminate\Support\Facades\Notification::sendNow()'
            message: 'writes belong in an Action'
            errorTip: 'Move the write into app/Actions/{Domain}/{Verb}{Noun}.php and call the Action from here. See ARCHITECTURE.md.'
            allowIn:
                - app/Actions/*
                - database/*
        -
            method:
                - 'App\Enums\*::from()'
                - 'App\Enums\*::tryFrom()'
            message: 'turn input into an enum only where input arrives'
            errorTip: 'FormRequests, Actions and console commands may call from() on input. In a controller, add a method to the FormRequest that calls $this->enum() (for example $request->status()). To get one enum from another, call a method on the enum (for example $role->locationType()); never rely on two enums sharing the same values.'
            allowIn:
                - app/Enums/*
                - app/Http/Requests/*
                - app/Actions/*
                - app/Console/*
        -
            method:
                - 'Illuminate\Support\Facades\Validator::*()'
            message: 'validate input in a FormRequest'
            errorTip: 'Create app/Http/Requests/{Domain}/{Verb}{Model}Request.php with the rules and type-hint it in the controller method. See docs/rules/form-requests.md.'
            allowIn:
                - app/Http/Fortify/*
        -
            method:
                - 'Illuminate\Database\Eloquent\Model::*()'
                - 'Illuminate\Database\Eloquent\Builder::*()'
                - 'Illuminate\Database\Query\Builder::*()'
                - 'Illuminate\Support\Facades\DB::*()'
            message: 'a FormRequest checks the shape of the input only'
            errorTip: 'Business state (stock, status, ownership, limits) is checked in the Action, which throws ValidationException::withMessages(). For "this record exists" use the exists and unique rules. See docs/rules/form-requests.md.'
            allowExceptIn:
                - app/Http/Requests/*
                - app/Concerns/*
        -
            method:
                - 'Illuminate\Http\Resources\Json\JsonResource::toArray()'
            message: 'list each field by name'
            errorTip: 'A Resource names every field it sends to React, so nothing private leaks and the TypeScript type can match it. See docs/rules/frontend.md.'
            allowExceptIn:
                - app/Http/Resources/*

        -
            method:
                - 'Illuminate\Database\Eloquent\Builder::where*()'
                - 'Illuminate\Database\Eloquent\Builder::orWhere*()'
                - 'Illuminate\Database\Query\Builder::where*()'
                - 'Illuminate\Database\Query\Builder::orWhere*()'
            exclude:
                - 'Illuminate\Database\Eloquent\Builder::whereKey()'
                - 'Illuminate\Database\Eloquent\Builder::whereKeyNot()'
            message: 'query conditions live in a model scope'
            errorTip: 'Add a #[Scope] method to the model (ownedBy(), open()) and call it by name. One record asks the same scope with whereKey($id)->exists(). See docs/rules/models.md.'
            allowIn:
                - app/Models/*
                - database/*
        -
            method:
                - 'Illuminate\Database\Eloquent\Builder::lockForUpdate()'
                - 'Illuminate\Database\Eloquent\Builder::sharedLock()'
                - 'Illuminate\Database\Eloquent\Builder::lock()'
            message: 'rows are locked only in an Action'
            errorTip: 'Lock inside the Action that writes, in its DB::transaction(), and test the lock in tests/Feature/{Domain}/{Action}LockTest.php. Pages and Actions that only read never lock. See docs/rules/tests.md, Row locks.'
            allowIn:
                - app/Actions/*
        -
            method:
                - 'Illuminate\Support\Facades\Event::*()'
                - 'Illuminate\Database\Eloquent\Model::observe()'
                - 'Illuminate\Database\Eloquent\Model::retrieved()'
                - 'Illuminate\Database\Eloquent\Model::saving()'
                - 'Illuminate\Database\Eloquent\Model::saved()'
                - 'Illuminate\Database\Eloquent\Model::creating()'
                - 'Illuminate\Database\Eloquent\Model::created()'
                - 'Illuminate\Database\Eloquent\Model::updating()'
                - 'Illuminate\Database\Eloquent\Model::updated()'
                - 'Illuminate\Database\Eloquent\Model::deleting()'
                - 'Illuminate\Database\Eloquent\Model::deleted()'
                - 'Illuminate\Database\Eloquent\Model::replicating()'
                - 'App\Models\*::retrieved()'
                - 'App\Models\*::saving()'
                - 'App\Models\*::saved()'
                - 'App\Models\*::creating()'
                - 'App\Models\*::created()'
                - 'App\Models\*::updating()'
                - 'App\Models\*::updated()'
                - 'App\Models\*::deleting()'
                - 'App\Models\*::deleted()'
                - 'App\Models\*::replicating()'
                - 'App\Models\*::restoring()'
                - 'App\Models\*::restored()'
                - 'App\Models\*::trashed()'
                - 'App\Models\*::forceDeleting()'
                - 'App\Models\*::forceDeleted()'
                - 'App\Models\*::observe()'
            message: 'no events or listeners'
            errorTip: 'Do the work in the Action, and call another Action from it when a second step is needed. Events and listeners hide who does what. See docs/rules/actions.md.'

    disallowedFunctionCalls:
        -
            function:
                - 'request()'
                - 'response()'
                - 'redirect()'
                - 'back()'
                - 'to_route()'
                - 'inertia()'
                - 'session()'
                - 'auth()'
                - 'abort()'
                - 'abort_if()'
                - 'abort_unless()'
                - 'url()'
                - 'cookie()'
            message: 'only controllers deal with the request'
            errorTip: 'Actions, enums, models, policies and notifications work with plain values (the validated array, models, enums): the controller reads the request and the signed-in user, passes them in and returns the response. A refusal in an Action is a ValidationException. See docs/rules/actions.md.'
            allowExceptIn:
                - app/Actions/*
                - app/Enums/*
                - app/Models/*
                - app/Policies/*
                - app/Notifications/*
        -
            function: 'validator()'
            message: 'validate input in a FormRequest'
            errorTip: 'Create app/Http/Requests/{Domain}/{Verb}{Model}Request.php with the rules and type-hint it in the controller method. See docs/rules/form-requests.md.'
            allowIn:
                - app/Http/Fortify/*
        -
            function:
                - 'event()'
            message: 'no events or listeners'
            errorTip: 'Do the work in the Action, and call another Action from it when a second step is needed. Events and listeners hide who does what. See docs/rules/actions.md.'
