{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ryanc342/laravel-agent-starter",
    "type": "project",
    "description": "Laravel Agent Starter: a Laravel + Inertia + React starter kit with agent guidance and automated architecture checks.",
    "keywords": [
        "laravel",
        "react",
        "inertia",
        "ai",
        "starter-kit"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4.1",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "spaze/phpstan-disallowed-calls": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lint\\PHPStan\\": "lint/phpstan/",
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php artisan starter:initialize"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "check": [
            "Composer\\Config::disableProcessTimeout",
            "@php scripts/check.php"
        ],
        "check:static": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "npm run check",
            "npm run types:check"
        ],
        "check:milestone": [
            "Composer\\Config::disableProcessTimeout",
            "@php scripts/check-milestone.php"
        ],
        "ci:check": [
            "@check"
        ],
        "check:reference": [
            "Composer\\Config::disableProcessTimeout",
            "bash scripts/check-reference"
        ],
        "types:check": [
            "phpstan analyse --memory-limit=1G"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "npm test",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan starter:initialize"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": [
                    "@php artisan starter:initialize"
                ]
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
